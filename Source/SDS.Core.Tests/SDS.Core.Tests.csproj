<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>SDS.Core.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GenerateDependencyFile>true</GenerateDependencyFile>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="SdsGameDir" Value="$(GameDir)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(GameDir)\Assembly-CSharp.dll" Link="Assembly-CSharp.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(GameDir)\UnityStubs.dll" Link="UnityStubs.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SDS.Contracts\SDS.Contracts.csproj" />
    <ProjectReference Include="..\SDS.Diag\SDS.Diag.csproj" />
    <ProjectReference Include="..\SDS.Core\SDS.Core.csproj" />
  </ItemGroup>

</Project>
